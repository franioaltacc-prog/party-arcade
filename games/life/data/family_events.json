{
  "_help": "Shared events that hit the whole family when a year passes. cond uses family variables (see README). 'each' = effects for every living sibling (optionally filtered with each_cond). 'family' = family-wide changes. sib_rel_all changes every sibling-to-sibling relationship.",
  "chance_per_year": 0.32,
  "events": [
    {"id": "divorce", "weight": 0.5, "once": true, "cond": "parents_married and parents_alive == 2 and youngest_age >= 3",
     "text": "💔 {mom} and {dad} are getting divorced. The house feels quiet.",
     "family": {"divorce": true}, "each": {"happy": [-12, -6], "rel_parents": -4}, "sib_rel_all": 4},
    {"id": "remarry", "weight": 0.3, "once": true, "cond": "not parents_married and parents_alive == 2",
     "text": "💒 Plot twist! {mom} and {dad} got back together!",
     "family": {"remarry": true}, "each": {"happy": [6, 10], "rel_parents": 3}},
    {"id": "move", "weight": 0.6, "cond": "minors > 0",
     "text": "🚚 The {last} family is moving to {newplace}!",
     "family": {"move": true}, "each_cond": "living_home", "each": {"happy": [-6, 6]}},
    {"id": "surprise_trip", "weight": 0.8, "cond": "family_money >= 6000 and minors > 0 and parents_alive > 0",
     "text": "🏖️ Surprise! The parents took the whole family on a trip to {destination}!",
     "family": {"money": -4000}, "each_cond": "living_home", "each": {"happy": [6, 12], "rel_parents": 3}, "sib_rel_all": 3},
    {"id": "new_pet", "weight": 0.8, "cond": "family_pets == 0 and minors > 0",
     "text": "🐾 The family adopted a {petkind} named {petname}! {petemoji}",
     "family": {"pet_add": true}, "each": {"happy": [4, 8]}},
    {"id": "pet_dies", "weight": 1.2, "cond": "family_pets > 0 and pet_age >= 9",
     "text": "🌈 The family {petkind} {petname} crossed the rainbow bridge.",
     "family": {"pet_die": true}, "each": {"happy": [-8, -4]}},
    {"id": "inheritance", "weight": 0.35, "once": true, "cond": "year >= 2030",
     "text": "📜 Great-Aunt Gertrude left the {last} family {amount}! The siblings need to decide how to split it.",
     "family": {"inheritance": [40000, 400000]}, "each": {"happy": 3}},
    {"id": "promotion", "weight": 0.8, "cond": "parents_alive > 0",
     "text": "📈 {parent} got a big promotion at work!",
     "family": {"money": [5000, 20000]}, "each": {"happy": 2}},
    {"id": "job_loss", "weight": 0.5, "cond": "parents_alive > 0 and minors > 0",
     "text": "📉 {parent} lost their job. Money is tight this year.",
     "family": {"money": [-10000, -3000]}, "each_cond": "age < 18", "each": {"happy": -4}},
    {"id": "game_night", "weight": 1, "cond": "minors > 0 and siblings >= 2",
     "text": "🎲 Family game night got WAY too competitive. Someone flipped the board.",
     "each_cond": "living_home", "each": {"happy": 4, "chaos": 1}, "sib_rel_all": [-2, 5]},
    {"id": "grandma", "weight": 1, "cond": "minors > 0",
     "text": "👵 Grandma came to visit and brought a mountain of cookies!",
     "each": {"happy": 5, "health": -1}},
    {"id": "flood", "weight": 0.3, "cond": "at_home > 0",
     "text": "🌊 The basement flooded! Everyone's old toys floated away.",
     "family": {"money": -5000}, "each_cond": "living_home", "each": {"happy": -3}},
    {"id": "family_lottery", "weight": 0.15, "once": true, "cond": "parents_alive > 0",
     "text": "🍀 {parent}'s lottery ticket won $50,000!",
     "family": {"money": 50000}, "each": {"happy": 8}},
    {"id": "rivalry", "weight": 0.8, "cond": "siblings >= 2 and minors > 0",
     "text": "⚔️ Sibling rivalry season! Everyone is competing for the parents' attention.",
     "each": {"happy": -1}, "sib_rel_all": -4},
    {"id": "reunion", "weight": 0.8, "cond": "oldest_age >= 25 and siblings >= 2",
     "text": "🎉 Big {last} family reunion! Everyone came home for the weekend.",
     "each": {"happy": 6}, "sib_rel_all": 5},
    {"id": "parent_sick", "weight": 0.9, "cond": "parents_alive > 0 and oldest_parent_age >= 55",
     "text": "🏥 {parent} is in the hospital for a while.",
     "family": {"parent_health": -20}, "each": {"happy": -5}},
    {"id": "power_outage", "weight": 0.6, "cond": "minors > 0",
     "text": "🕯️ A huge storm knocked out the power. The family told ghost stories by candlelight.",
     "each_cond": "living_home", "each": {"happy": 3}, "sib_rel_all": 3}
  ]
}
